rules_version = '2';
// Reglas de seguridad de Dragon Fall:
// - cada jugador solo puede leer y escribir su propia partida;
// - el ranking semanal lo puede leer cualquiera, pero cada jugador solo escribe su propia marca,
//   con valores razonables y solo para mejorarla.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'save', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.save is map;
    }
    // Ranking semanal: colecciones rank_inf_2026w44, rank_kill_2026w44…
    match /{col}/{uid} {
      allow read: if col.matches('rank_(inf|kill)_[0-9]{4}w[0-9]{2}');
      allow delete: if col.matches('rank_(inf|kill)_[0-9]{4}w[0-9]{2}')
        && request.auth != null && request.auth.uid == uid;
      allow create, update: if col.matches('rank_(inf|kill)_[0-9]{4}w[0-9]{2}')
        && request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'title', 'cid', 'score', 't', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.cid is string && request.resource.data.cid.size() <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0
        && request.resource.data.t is int && request.resource.data.t >= 0 && request.resource.data.t <= 36000
        && request.resource.data.score <= request.resource.data.t * 80 + 5000
        && (resource == null || request.resource.data.score > resource.data.score);
    }
    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
